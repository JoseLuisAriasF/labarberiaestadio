# Supabase → Project Settings → API. La "publishable/anon" es pública (va al navegador).
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Barbería que muestra la portada (las demás: /?b=B2)
PUBLIC_BARBERIA=B1
SITE_URL=https://labarberiaestadio.pages.dev
# Opcional: Cloudflare Turnstile (anti-bots en el registro de dueños)
PUBLIC_TURNSTILE_SITE_KEY=
