---
import ThemeToggle from './ThemeToggle.astro';
interface Props { privado?: boolean; nombre: string; logo?: string }
const { privado = false, nombre, logo = '/logo-barberia.jpg' } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/', texto: 'Cita en vivo', emoji: '🏠', icono: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/productos', texto: 'Productos', emoji: '💈', icono: 'M6 7h12l-1 13H7L6 7Zm3 0V5a3 3 0 0 1 6 0v2' },
  { href: '/como-llegar', texto: 'Cómo llegar', emoji: '📍', icono: 'M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z' },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[var(--superficie)]/80 border-b border-base-300/40 dark:border-base-700/40">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 flex items-center gap-2">
    <a href="/" data-tenant class="flex items-center gap-2 shrink-0 titulo">
      <img src={logo} alt="" class="size-10 rounded-lg object-contain bg-black" width="40" height="40" />
      <span class="hidden sm:inline">{nombre}</span>
    </a>

    {!privado && (
      <nav class="hidden md:flex items-center gap-1 ml-3" aria-label="Principal">
        {enlaces.map((e) => (
          <a href={e.href} data-tenant aria-current={ruta === e.href ? 'page' : undefined}
             class="neu-press rounded-xl px-3 py-2 text-sm aria-[current=page]:neu-inset aria-[current=page]:text-acento-500 hover:text-acento-500">
            <span aria-hidden="true">{e.emoji}</span> {e.texto}
          </a>
        ))}
      </nav>
    )}

    <div class="ml-auto flex items-center gap-2">
      <div class="hidden sm:block"><ThemeToggle /></div>
      {!privado && (
        <div data-cuenta data-guia="perfil" class="relative">
          <a href="/acceso" data-tenant data-login class="btn !px-3" aria-label="Entrar a mi cuenta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            <span>Entrar</span>
          </a>
          <button type="button" data-avatar hidden aria-haspopup="menu" aria-expanded="false" aria-label="Mi cuenta"
            class="grid size-10 place-items-center overflow-hidden rounded-full bg-acento-500 text-sm font-bold text-black ring-2 ring-acento-500/50 transition hover:ring-acento-500">
            <img data-avatar-img hidden alt="" referrerpolicy="no-referrer" class="size-full object-cover" />
            <span data-iniciales></span>
          </button>
          <div data-menu-cuenta hidden role="menu" class="neu absolute right-0 z-50 mt-2 grid w-56 gap-1 rounded-2xl p-2">
            <p data-nombre class="truncate px-3 py-2 text-sm font-semibold"></p>
            <a href="/perfil" data-tenant role="menuitem" class="rounded-xl px-3 py-2 text-sm hover:bg-acento-500/10">Mi perfil</a>
            <button type="button" data-salir-cuenta role="menuitem" class="rounded-xl px-3 py-2 text-left text-sm text-red-500 hover:bg-red-500/10">Cerrar sesión</button>
          </div>
        </div>
      )}
      {privado && <button data-salir class="btn !px-3">Salir</button>}
      {!privado && (
        <button data-menu-abrir aria-label="Menú" aria-expanded="false" class="md:hidden btn !px-3">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class="size-4"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      )}
    </div>
  </div>

  {!privado && (
    <div data-menu-panel hidden class="md:hidden border-t border-base-300/40 dark:border-base-700/40">
      <nav class="max-w-6xl mx-auto px-3 py-3 grid gap-1.5">
        {enlaces.map((e) => (
          <a href={e.href} data-tenant class="neu-sm neu-press rounded-xl px-3 py-2.5 text-sm flex items-center gap-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" class="size-4 text-acento-500 shrink-0"><path d={e.icono} /></svg>
            {e.texto}
          </a>
        ))}
        <div data-cuenta-movil hidden class="grid gap-1.5 pt-2 mt-1 border-t border-base-300/40 dark:border-base-700/40">
          <p data-nombre-movil class="px-1 text-sm font-semibold"></p>
          <a href="/perfil" data-tenant class="neu-sm neu-press rounded-xl px-3 py-2.5 text-sm">Mi perfil</a>
          <button type="button" data-salir-cuenta class="neu-sm neu-press rounded-xl px-3 py-2.5 text-left text-sm text-red-500">Cerrar sesión</button>
        </div>
        <a href="/acceso" data-tenant data-login-movil class="neu-sm neu-press rounded-xl px-3 py-2.5 text-sm flex items-center gap-3">Entrar o crear cuenta</a>
        <div class="flex items-center justify-between pt-2 mt-1 border-t border-base-300/40 dark:border-base-700/40">
          <ThemeToggle />
          <a href="/login" class="text-xs text-base-500 hover:text-acento-500">Acceso staff</a>
        </div>
      </nav>
    </div>
  )}
</header>

<script>
  import { supabase } from '@/lib/supabase';
  // Conserva ?b=B2 al navegar entre secciones de otra barbería.
  const b = new URLSearchParams(location.search).get('b');
  if (b && /^B\d+$/i.test(b)) document.querySelectorAll<HTMLAnchorElement>('a[data-tenant]').forEach((a) => {
    const u = new URL(a.href); u.searchParams.set('b', b); a.href = u.toString();
  });
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-abrir]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  btn?.addEventListener('click', () => {
    panel!.hidden = !panel!.hidden;
    btn.setAttribute('aria-expanded', String(!panel!.hidden));
  });
  document.querySelector('[data-salir]')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    location.href = '/login';
  });

  const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');
  if (cuenta) {
    const login = cuenta.querySelector<HTMLElement>('[data-login]')!;
    const avatar = cuenta.querySelector<HTMLButtonElement>('[data-avatar]')!;
    const avatarImg = cuenta.querySelector<HTMLImageElement>('[data-avatar-img]')!;
    const iniciales = cuenta.querySelector<HTMLElement>('[data-iniciales]')!;
    const menu = cuenta.querySelector<HTMLElement>('[data-menu-cuenta]')!;
    const nombreMenu = cuenta.querySelector<HTMLElement>('[data-nombre]')!;
    const movilCuenta = document.querySelector<HTMLElement>('[data-cuenta-movil]')!;
    const movilLogin = document.querySelector<HTMLElement>('[data-login-movil]')!;
    const nombreMovil = document.querySelector<HTMLElement>('[data-nombre-movil]')!;

    const sigla = (n: string) => n.trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase() || '?';

    async function pintar(user: { id: string; user_metadata?: Record<string, unknown> } | null) {
      if (!user) {
        login.hidden = false; avatar.hidden = true; menu.hidden = true;
        movilCuenta.hidden = true; movilLogin.hidden = false;
        return;
      }
      const { data: c } = await supabase.from('clientes').select('nombre').maybeSingle();
      const meta = user.user_metadata ?? {};
      const nombre = c?.nombre || String(meta.nombre ?? meta.full_name ?? meta.name ?? '') || 'Mi cuenta';
      const foto = typeof meta.avatar_url === 'string' ? meta.avatar_url : '';
      iniciales.textContent = sigla(nombre);
      iniciales.hidden = !!foto;
      avatarImg.hidden = !foto;
      if (foto) avatarImg.src = foto;
      avatar.setAttribute('aria-label', `Mi cuenta: ${nombre}`);
      nombreMenu.textContent = nombre;
      nombreMovil.textContent = nombre;
      login.hidden = true; avatar.hidden = false;
      movilCuenta.hidden = false; movilLogin.hidden = true;
    }

    const { data: { session } } = await supabase.auth.getSession();
    await pintar(session?.user ?? null);
    supabase.auth.onAuthStateChange((_e, s) => { pintar(s?.user ?? null); });

    const abrir = (abierto: boolean) => {
      menu.hidden = !abierto;
      avatar.setAttribute('aria-expanded', String(abierto));
    };
    avatar.addEventListener('click', (e) => { e.stopPropagation(); abrir(menu.hidden); });
    document.addEventListener('click', (e) => { if (!cuenta.contains(e.target as Node)) abrir(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') abrir(false); });

    document.querySelectorAll<HTMLElement>('[data-salir-cuenta]').forEach((b) => b.addEventListener('click', async () => {
      await supabase.auth.signOut();
      location.href = '/';
    }));
  }
</script>
